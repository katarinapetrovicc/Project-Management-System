@page
@model Projekat.Pages.TeamMemberPage.DeleteModel

@{
    ViewData["Title"] = "Delete Team Member";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Delete Team Member</h1>

@if (Model.TeamMember == null)
{
    <p><em>Team Member not found.</em></p>
}
else
{
    <h4>Are you sure you want to delete this team member?</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Team</dt>
        <dd class="col-sm-10">@Model.TeamMember.Team?.Name</dd>

        <dt class="col-sm-2">Employee</dt>
        <dd class="col-sm-10">@Model.TeamMember.Employee?.FirstName @Model.TeamMember.Employee?.LastName</dd>

        <dt class="col-sm-2">Role In Team</dt>
        <dd class="col-sm-10">@Model.TeamMember.RoleInTeam</dd>
    </dl>

    <!-- Dugmad odvojena -->
    <div class="mt-3">
        <form method="post" style="display:inline">
            <input type="hidden" asp-for="TeamMember.ID" />
            <button type="submit" class="btn btn-danger">Delete</button>
        </form>
        <a asp-page="./TeamMember" class="btn btn-secondary ml-2">Cancel</a>
    </div>
}
