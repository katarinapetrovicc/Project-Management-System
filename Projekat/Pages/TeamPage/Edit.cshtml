@page
@model Projekat.Pages.TeamPage.EditModel
@{
    ViewData["Title"] = "Edit Team";
}

<h2>Edit Team</h2>

@if (Model.Team != null)
{
    <form method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Team.ID" />

        <div class="form-group mb-3">
            <label asp-for="Team.Name" class="form-label"></label>
            <input asp-for="Team.Name" class="form-control" />
            <span asp-validation-for="Team.Name" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label class="form-label">Current Logo</label>
            <div class="mb-2">
                <img src="@Model.TeamLogoPath" alt="@Model.Team.Name" width="60" height="60" class="mb-2" />
                <div>
                    <input type="checkbox" asp-for="RemoveLogo" /> Remove existing logo
                </div>
            </div>
        </div>

        <div class="form-group mb-4">
            <label class="form-label">New Logo (optional)</label>
            <input type="file" asp-for="LogoFile" class="form-control" />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="Team" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
}
else
{
    <p><em>Team not found.</em></p>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
