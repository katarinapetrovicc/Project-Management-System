@page
@model Projekat.Pages.TeamPage.DeleteModel
@{
    ViewData["Title"] = "Delete Team";
}

<h1>Delete Team</h1>

<h4>Are you sure you want to delete this team?</h4>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Name
        </dt>
        <dd class="col-sm-10">
            @Model.Team.Name
        </dd>

        <dt class="col-sm-2">
            Team Logo
        </dt>
        <dd class="col-sm-10">
            <img src="@Model.TeamLogoPath"
                 alt="@Model.Team.Name"
                 style="max-width:200px; max-height:200px;" />
        </dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Team.ID" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="./Team" class="btn btn-secondary">Cancel</a>
    </form>
</div>
