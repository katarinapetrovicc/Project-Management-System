@page
@model Projekat.Pages.TeamPage.DetailsModel
@{
    ViewData["Title"] = "Team Details";
}

<h2>Team Details</h2>
<hr />

<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Team.Name</dd>

    <dt class="col-sm-2">Logo</dt>
    <dd class="col-sm-10">
        <img src="@Model.TeamLogoPath"
             alt="@Model.Team.Name"
             style="max-width:150px; max-height:150px;" />
    </dd>
</dl>

<div>
    <a asp-page="./Edit" asp-route-id="@Model.Team.ID" class="btn btn-primary">Edit</a>
    <a asp-page="./Delete" asp-route-id="@Model.Team.ID" class="btn btn-danger">Delete</a>
    <a asp-page="./Team" class="btn btn-secondary">Back to List</a>
</div>
