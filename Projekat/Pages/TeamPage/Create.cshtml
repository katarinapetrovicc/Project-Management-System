@page
@model Projekat.Pages.TeamPage.CreateModel
@{
    ViewData["Title"] = "Create Team";
}

<h1>Create Team</h1>

<form method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label asp-for="Team.Name"></label>
        <input asp-for="Team.Name" class="form-control" placeholder="Enter team name" />
        <span asp-validation-for="Team.Name" class="text-danger"></span>
    </div>

    <div class="form-group mt-2">
        <label>Logo (optional)</label>
        <input type="file" asp-for="LogoFile" class="form-control" />
        <small class="text-muted">Ako ne dodate logo, sistem će pokušati da ga pronađe po imenu tima.</small>
    </div>

    <div class="form-group mt-3">
        <button type="submit" class="btn btn-primary">Create</button>
        <a asp-page="Team" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
