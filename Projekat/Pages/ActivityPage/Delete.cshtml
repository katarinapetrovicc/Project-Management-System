@page
@model Projekat.Pages.Activities.DeleteModel
@{
    ViewData["Title"] = "Delete Activity";
}

<h2>Delete Activity</h2>

@if (Model.Activity == null)
{
    <p><em>Activity not found.</em></p>
}
else
{
    <h4>Are you sure you want to delete this activity?</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Activity.Name</dd>

        <dt class="col-sm-2">Task</dt>
        <dd class="col-sm-10">@Model.Activity.Task?.Name</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Activity.Description</dd>

        <dt class="col-sm-2">Planned Hours</dt>
        <dd class="col-sm-10">@Model.Activity.PlannedHours</dd>

        <dt class="col-sm-2">Actual Hours</dt>
        <dd class="col-sm-10">@Model.Activity.ActualHours</dd>

        <dt class="col-sm-2">Date Performed</dt>
        <dd class="col-sm-10">@Model.Activity.DatePerformed</dd>

        <dt class="col-sm-2">Attachment</dt>
        <dd class="col-sm-10">
            @if (Model.Activity.Attachment != null && Model.Activity.Attachment.Length > 0)
            {
                <a asp-page="./DownloadAttachment" asp-route-id="@Model.Activity.ID">Download</a>
            }
            else
            {
                <span>No file</span>
            }
        </dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Activity.ID" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Activity" class="btn btn-secondary">Cancel</a>
    </form>
}
