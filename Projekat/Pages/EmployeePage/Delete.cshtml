@page
@model Projekat.Pages.EmployeePage.DeleteModel
@{
    ViewData["Title"] = "Delete Employee";
}

<h2>Delete Employee</h2>

@if (Model.Employee == null)
{
    <p><em>Employee not found.</em></p>
}
else
{
    <h4>Are you sure you want to delete this employee?</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">First Name</dt>
        <dd class="col-sm-10">@Model.Employee.FirstName</dd>

        <dt class="col-sm-2">Last Name</dt>
        <dd class="col-sm-10">@Model.Employee.LastName</dd>

        <dt class="col-sm-2">Position</dt>
        <dd class="col-sm-10">@Model.Employee.Position</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Employee.Email</dd>

        <dt class="col-sm-2">Phone</dt>
        <dd class="col-sm-10">@Model.Employee.Phone</dd>

        <dt class="col-sm-2">Profile Image</dt>
        <dd class="col-sm-10">
            <img src="@Model.EmployeeImagePath"
                 alt="@Model.Employee.FirstName"
                 style="max-width:100px; max-height:100px;" />
        </dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Employee.ID" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Employee" class="btn btn-secondary">Cancel</a>
    </form>
}
