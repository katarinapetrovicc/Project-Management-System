@page
@model Projekat.Pages.AssignmentPage.DeleteModel

@{
    ViewData["Title"] = "Delete Assignment";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Delete Assignment</h1>

@if (Model.Assignment == null)
{
    <p><em>Assignment not found.</em></p>
}
else
{
    <h4>Are you sure you want to delete this assignment?</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Employee</dt>
        <dd class="col-sm-10">@Model.Assignment.Employee?.FirstName @Model.Assignment.Employee?.LastName</dd>

        <dt class="col-sm-2">Activity</dt>
        <dd class="col-sm-10">@Model.Assignment.Activity?.Name</dd>

        <dt class="col-sm-2">Assigned Days</dt>
        <dd class="col-sm-10">@Model.Assignment.AssignedDays</dd>

        <dt class="col-sm-2">Month</dt>
        <dd class="col-sm-10">@Model.Assignment.Month</dd>

        <dt class="col-sm-2">Year</dt>
        <dd class="col-sm-10">@Model.Assignment.Year</dd>

        <dt class="col-sm-2">Progress</dt>
        <dd class="col-sm-10">@Model.Assignment.Progress %</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Assignment.ID" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="./Assignment" class="btn btn-secondary ml-2">Cancel</a>
    </form>
}
