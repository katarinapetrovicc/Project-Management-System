@page
@model Projekat.Pages.ProjectPage.CreateModel
@{
    ViewData["Title"] = "Create Project";
}

<h1>Create New Project</h1>

<form method="post">
    <div class="form-group">
        <label asp-for="Project.Name"></label>
        <input asp-for="Project.Name" class="form-control" />
        <span asp-validation-for="Project.Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Project.Description"></label>
        <textarea asp-for="Project.Description" class="form-control"></textarea>
        <span asp-validation-for="Project.Description" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Project.StartDate"></label>
        <input asp-for="Project.StartDate" type="date" class="form-control" />
        <span asp-validation-for="Project.StartDate" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Project.EndDate"></label>
        <input asp-for="Project.EndDate" type="date" class="form-control" />
        <span asp-validation-for="Project.EndDate" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Project.Budget"></label>
        <input asp-for="Project.Budget" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Project.Budget" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Project.Status"></label>
        <select asp-for="Project.Status" class="form-control">
            <option value="Planned">Planned</option>
            <option value="Active">Active</option>
            <option value="Completed">Completed</option>
        </select>
        <span asp-validation-for="Project.Status" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-page="./Projekti" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
