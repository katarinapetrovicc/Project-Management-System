@page
@model Projekat.Pages.TaskPage.TaskModel

@{
    ViewData["Title"] = "Tasks";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Tasks</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Create New Task</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Tasks[0].Name)</th>
            <th>@Html.DisplayNameFor(model => model.Tasks[0].Description)</th>
            <th>@Html.DisplayNameFor(model => model.Tasks[0].PlannedHours)</th>
            <th>@Html.DisplayNameFor(model => model.Tasks[0].ActualHours)</th>
            <th>@Html.DisplayNameFor(model => model.Tasks[0].Deadline)</th>
            <th>@Html.DisplayNameFor(model => model.Tasks[0].Status)</th>
            <th>Work Package</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Tasks)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.Description)</td>
                <td>@Html.DisplayFor(modelItem => item.PlannedHours)</td>
                <td>@Html.DisplayFor(modelItem => item.ActualHours)</td>
                <td>@Html.DisplayFor(modelItem => item.Deadline)</td>
                <td>@Html.DisplayFor(modelItem => item.Status)</td>
                <td>@(item.WorkPackage != null ? item.WorkPackage.Name : "")</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
