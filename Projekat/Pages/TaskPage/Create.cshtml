@page
@model Projekat.Pages.TaskPage.CreateModel

@{
    ViewData["Title"] = "Create Task";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Create Task</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Task.WorkPackageID" class="form-label"></label>
                <select asp-for="Task.WorkPackageID" class="form-control" asp-items="Model.WorkPackageList">
                    <option value="">-- Select Work Package --</option>
                </select>
                <span asp-validation-for="Task.WorkPackageID" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Task.Name" class="form-label"></label>
                <input asp-for="Task.Name" class="form-control" />
                <span asp-validation-for="Task.Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Task.Description" class="form-label"></label>
                <textarea asp-for="Task.Description" class="form-control"></textarea>
                <span asp-validation-for="Task.Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Task.PlannedHours" class="form-label"></label>
                <input asp-for="Task.PlannedHours" type="number" class="form-control" />
                <span asp-validation-for="Task.PlannedHours" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Task.ActualHours" class="form-label"></label>
                <input asp-for="Task.ActualHours" type="number" class="form-control" />
                <span asp-validation-for="Task.ActualHours" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Task.Deadline" class="form-label"></label>
                <input asp-for="Task.Deadline" type="date" class="form-control" />
                <span asp-validation-for="Task.Deadline" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Task.Status" class="form-label"></label>
                <select asp-for="Task.Status" class="form-control">
                    <option value="">-- Select Status --</option>
                    <option value="Planned">Planned</option>
                    <option value="In Progress">In Progress</option>
                    <option value="Completed">Completed</option>
                </select>
                <span asp-validation-for="Task.Status" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-page="./Task" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
